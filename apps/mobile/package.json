{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:android": "eas build --profile production --platform android",
    "build:android:local": "eas build --profile production --platform android --local",
    "build:ios": "eas build --profile production --platform ios",
    "build:ios:local": "eas build --profile production --platform ios --local",
    "build:list": "eas build:list --limit 5",
    "gen:icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.16",
    "@grana/accounts": "workspace:*",
    "@grana/cards": "workspace:*",
    "@grana/dashboard": "workspace:*",
    "@grana/i18n-messages": "workspace:*",
    "@grana/money-logic": "workspace:*",
    "@grana/movement-form": "workspace:*",
    "@grana/recurrences": "workspace:*",
    "@grana/savings": "workspace:*",
    "@grana/shared": "workspace:*",
    "@grana/supabase": "workspace:*",
    "@grana/transactions": "workspace:*",
    "@grana/transactions-mutations": "workspace:*",
    "@grana/ui-contracts": "workspace:*",
    "@grana/validation": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "5.100.13",
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.16.0",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.4",
    "react-native-keyboard-controller": "^1.22.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@grana/ui-tokens": "workspace:*",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.12",
    "eas-cli": "^18.13.0",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~57.0.2",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react-native-keyboard-controller",
        "typescript"
      ]
    }
  }
}
